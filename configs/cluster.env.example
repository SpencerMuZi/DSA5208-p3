# Copy to configs/cluster.env on the CLUSTER. Never store passwords here.
# Fill values from your DSA5208 / NUS IT instructions, then set SITE_CONFIRMED=1.
SITE_CONFIRMED=0
CLUSTER_NAME=Vanda
SCHEDULER=PBS
QUEUE=UNSET
# Leave PROJECT_CODE empty ONLY if your approved queue needs no project/account.
PROJECT_CODE=''
# NUS examples use -P. Some PBS sites use -A; follow your approved instructions.
PROJECT_FLAG=-P
MPI_FLAVOR=openmpi
# Set to 1 only after confirming your Open MPI uses the PBS allocation correctly.
MPI_PBS_INTEGRATED=0
# Do not copy these defaults as claims about the actual node specification.
MAX_CPUS_PER_NODE=8
MEMORY_PER_NODE=2gb
WALLTIME=00:30:00
OMP_PLACES=cores
OMP_PROC_BIND=close
