#!/bin/bash
#PBS -N jacobi-cpu
#PBS -q auto
#PBS -l select=1:ncpus=4:mpiprocs=2:ompthreads=2:mem=16gb:node_pool=cpu_node
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the source root}"
source scripts/environment.sh
bash scripts/build.sh cpu
python3 scripts/benchmark.py --variants hybrid --dim 2 --n 1024 --iters 5000 \
    --ranks 2 --threads 2 --nodes 1 --ranks-per-node 2
